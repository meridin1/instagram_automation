APP_ENV=development
APP_NAME=Meridin Instagram Automation
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=meridin_instagram

JWT_SECRET=REPLACE_WITH_A_UNIQUE_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

CORS_ORIGINS=http://localhost:8000,http://localhost:5173

# Meta/Instagram app settings are configured in the Admin dashboard and stored encrypted in MongoDB.
LLM_ENABLED=false
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_STYLE=responses
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
LLM_TIMEOUT_SECONDS=20
LLM_MAX_OUTPUT_TOKENS=700

LOG_LEVEL=INFO

# Admin panel (server-side only; never expose these values in frontend code)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-to-a-long-random-password

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
